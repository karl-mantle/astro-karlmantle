---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"li"> {
  description: string;
  heading: string;
  preview?: string;
  github: string;
}

const { description, heading, github, preview } = Astro.props;
---

<li class="group/card flex flex-col gap-2 border border-white p-4 text-sm sm:gap-4">
  <h2 class="text-bold text-lg group-hover/card:underline">
    {heading}
  </h2>
  <p>{description}</p>

  <div class="mt-auto">
    <a href={github} class="underline hover:no-underline" target="_blank" rel="noopener noreferrer"
      >GitHub</a
    >
    {
      preview && (
        <>
          {" | "}
          <a
            href={preview}
            class="underline hover:no-underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            Preview
          </a>
        </>
      )
    }
  </div>
</li>
