---
import Base from "~/layouts/Base.astro";
import Form from "~/components/interactive/ContactForm.astro";
---

<Base
  type="webpage"
  title="Contact"
  description="Fill out the form to get in touch, or feel free to send me an email."
  load={{ turnstile: true }}
>
  <section class="mt-8 flex flex-col gap-4 lowercase sm:mt-16">
    <h1 class="text-2xl font-bold">Contact</h1>
    <p class="sm:mb-4">You can contact me via the form below.</p>
    <Form />
  </section>
</Base>
